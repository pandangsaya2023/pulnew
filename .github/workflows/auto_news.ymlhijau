name: Robot Ambil Berita Otomatis
on:
  workflow_dispatch:
  schedule:
    - cron: '0 */2 * * *'

jobs:
  scrape:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      
      - name: Menyiapkan Python & Dependencies
        run: |
          python -m pip install --upgrade pip
          pip install requests openai beautifulsoup4 lxml
      
      - name: Jalankan Robot Pengambil Berita
        env:
          GROQ_API_KEY: ${{ secrets.GROQ_API_KEY }}
        run: python ambil_berita.py

      - name: Menggabungkan Berita (Manual & Robot)
        run: |
          # Install jq
          sudo apt-get install -y jq
          
          # Pastikan folder public/posts ada
          mkdir -p public/posts
          
          # Gabungkan semua file .json di folder public/posts ke posts.json
          # Kita menggunakan -s (slurp) untuk menggabungkan menjadi array
          jq -n '{posts: [inputs]}' public/posts/*.json > temp_gabungan.json
          
          # Urutkan berdasarkan tanggal (terbaru di atas)
          jq '.posts |= sort_by(.date) | .posts |= reverse | .posts |= .[0:200]' temp_gabungan.json > public/posts.json
          
          # Hapus file sementara
          rm temp_gabungan.json

      - name: Menyimpan Perubahan Kembali ke GitHub
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add public/posts.json
          git diff-index --quiet HEAD || git commit -m "Update posts.json via jq"
          git push

