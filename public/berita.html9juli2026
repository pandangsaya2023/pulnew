<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PULNEW - Detail Berita</title>
<meta property="og:title" content="PULNEW.com">
<meta property="og:description" content="">
<meta property="og:image" content="https://pulnew.pages.dev/media/og-default.jpg">
<meta property="og:url" content="">
<meta property="og:type" content="article">
<meta name="twitter:card" content="summary_large_image">

<style>
:root { --warna-merah: #d32f2f; --warna-biru: #1a237e; --warna-bg: #f4f6f9; }
* { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI',Roboto,Arial,sans-serif; }
html, body { background: var(--warna-bg); }
.header-container { background: #fff; position: sticky; top: 0; z-index: 200; border-bottom: 2px solid var(--warna-merah); }
.logo-bar { max-width: 1100px; margin: 0 auto; padding: 7px 20px; display: flex; justify-content: space-between; align-items: center; }
.logo-bar a { display: flex; align-items: center; gap: 10px; text-decoration: none; }
.logo-img-wrapper img { max-height: 45px; }
.logo-text { font-size: 24px; font-weight: 800; color: var(--warna-biru); font-family: 'Poppins', sans-serif; }
.logo-new { color: var(--warna-merah); }
.btn-beranda { background: #2e7d32; color: white; padding: 4px 12px; border-radius: 6px; text-decoration: none; font-weight: 600; font-size: 12px; }
.content-wrapper { max-width: 600px; margin: 0 auto; padding: 15px 15px 60px 15px; } /* DIKUNCI BIAR GAK MELEBAR */
.article-title { font-size: 22px; font-weight: 800; margin-bottom: 15px; line-height: 1.3; font-family: 'Poppins', sans-serif; }
.main-image { width: 100%; border-radius: 6px; margin-bottom: 15px; }
.article-body { font-size: 16px; line-height: 1.7; }
.article-body p { margin-bottom: 15px; }
.related-section { margin-top: 30px; padding-top: 20px; border-top: 2px solid #eee; }
.section-title { font-size: 18px; font-weight: 800; color: var(--warna-biru); margin-bottom: 12px; border-left: 4px solid var(--warna-merah); padding-left: 8px; font-family: 'Poppins', sans-serif; }
.related-item { display: flex; gap: 12px; padding: 10px 0; border-bottom: 1px solid #f0f0f0; text-decoration: none; color: #333; }
.related-item img { width: 80px; height: 60px; object-fit: cover; border-radius: 6px; }
.related-item h4 { font-size: 14px; font-weight: 700; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.footer-ticker { background: #d32f2f; color: white; padding: 8px 0; font-size: 13px; overflow: hidden; width: 100%; position: fixed; bottom: 0; left: 0; }
.ticker-content { display: inline-block; white-space: nowrap; padding-left: 100%; animation: ticker 40s linear infinite; }
@keyframes ticker { 0% { transform: translate3d(0, 0, 0); } 100% { transform: translate3d(-100%, 0, 0); }
.ad-slot { margin: 15px 0; text-align: center; }
.ad-slot img { width: 100%; max-width: 600px; height: auto; display: block; border-radius: 8px; margin: 0 auto; } /* IKLAN GAK MELEBAR */
</style>
</head>
<body>

<div class="header-container">
    <div class="logo-bar">
        <a href="https://pulnew.pages.dev/">
          <div class="logo-img-wrapper"><img src="https://pulnew.pages.dev/logopulnew.png" alt="Logo"></div>
          <div class="logo-text">PUL<span class="logo-new">NEW</span>.COM</div>
        </a>
        <a href="https://pulnew.pages.dev/" class="btn-beranda">← Beranda</a>
    </div>
</div>

<div class="content-wrapper">
    <div id="content-area">Memuat berita...</div>
</div>

<div class="footer-ticker"><div class="ticker-content" id="running-text">MEMUAT INFORMASI TERKINI...</div></div>

<script>
// KUNCI: KITA BACA DARI /posts.json BUKAN /posts/xxx.json
async function muatHalamanBerita() {
    const params = new URLSearchParams(window.location.search);
    const slugTujuan = params.get('slug');
    const contentArea = document.getElementById('content-area');

    if (!slugTujuan) {
        contentArea.innerHTML = "Error: Slug tidak ada di URL";
        return;
    }

    try {
        // 1. Ambil semua berita dari 1 file
        const res = await fetch('/posts.json?t=' + Date.now());
        if (!res.ok) throw new Error('Gagal load posts.json');
        const posts = await res.json();

        // 2. Cari berita yg slug nya sama persis
        const post = posts.find(p => p.slug === slugTujuan);

        if (!post) {
            contentArea.innerHTML = `Berita tidak ditemukan.<br><small>Slug yg dicari: ${slugTujuan}</small><br><small>Total berita di posts.json: ${posts.length}</small>`;
            return;
        }
        
        // 3. Update Meta buat share
        document.title = post.title + " - PULNEW.com";
        document.querySelector('meta[property="og:title"]').content = post.title;
        document.querySelector('meta[property="og:description"]').content = (post.body || '').substring(0,160);
        document.querySelector('meta[property="og:image"]').content = post.image.startsWith('http') ? post.image : 'https://pulnew.pages.dev' + post.image;
        document.querySelector('meta[property="og:url"]').content = window.location.href;

        const gambar = post.image.startsWith('http') ? post.image : 'https://pulnew.pages.dev' + post.image;
        const isi = (post.body || post.content || '').split('\n').map(p => p.trim() ? `<p>${p}</p>` : '').join('');

        let html = `
            <h1 class="article-title">${post.title}</h1>
            <div class="ad-slot"><img src="https://pulnew.pages.dev/media/iklan_berita_atas1.png"></div>
            <img src="${gambar}" class="main-image">
            <div class="article-body">${isi}</div>
            <div class="ad-slot"><img src="https://pulnew.pages.dev/media/iklan_berita_tengah1.png"></div>
        `;
        
        // 4. Berita lainnya
        const related = posts.filter(p => p.slug !== slugTujuan).slice(0, 5);
        if (related.length > 0) {
            html += `<div class="related-section"><div class="section-title">Berita Lainnya</div>`;
            related.forEach(r => {
                const gambarR = r.image.startsWith('http') ? r.image : 'https://pulnew.pages.dev' + r.image;
                html += `<a href="/berita.html?slug=${r.slug}" class="related-item"><img src="${gambarR}"><h4>${r.title}</h4></a>`;
            });
            html += `</div>`;
        }
        contentArea.innerHTML = html;
        document.getElementById('running-text').textContent = `INFO NEWS: ${post.title}`;

    } catch (e) {
        contentArea.innerHTML = "Error: " + e.message;
    }
}
muatHalamanBerita();
</script>
</body>
</html>
